# Simulation build artifacts. Everything here is regenerated by
# simulation/questa/run_sim.tcl or simulation/verilator/run_sim.sh.
#
# These were previously untracked-but-present in working copies of the sibling
# AXI core, which is how a transcript from a shorter run once ended up being
# cited as the suite's current status. Keep them out.

# Questa / ModelSim
work/
transcript
run.log
*.ucdb
*.wlf
*.vstf
modelsim.ini
vsim.dbg
coverage_report.txt
covhtmlreport/

# Verilator
obj_dir/
obj_dir_*/
run_wresp*.log
coverage.dat

# Icarus
*.out
*.vvp
*.vcd

# Python (diagram generator, slang checker, fact checker)
__pycache__/
*.pyc

# Document build intermediates. The .md and the .pdf are tracked; the HTML
# handed to WeasyPrint is a debugging aid only.
doc/tools/.render_*.html

# Editor / OS
*~
.DS_Store

# Waveform capture (regenerated by verification/capture.sh)
verification/wave.vcd
verification/obj_dir/

# Quartus build artifacts (example/de10_lite_rtl/quartus/). Everything here is
# regenerated by a compile; the .qpf/.qsf/.sdc are the tracked sources.
# The .sof is deliberately NOT tracked - a bitstream that drifts from the RTL
# beside it is worse than no bitstream, and it is a two-minute rebuild.
db/
incremental_db/
output_files/
*.qws
*.sof
*.pof
*.rpt
*.summary
*.jdi
*.pin
*.done
*.smsg
*.sld
*.qdf
hc_output/
greybox_tmp/

# Nios II example build artifacts (example/de10_lite_nios/).
#
# firewall_sys.qsys IS tracked, so the system can be opened in the Platform
# Designer GUI straight from a clone; qsys/build_system.tcl remains the source
# of truth and ./build.sh clean deliberately leaves the .qsys alone.
example/de10_lite_nios/qsys/firewall_sys/
example/de10_lite_nios/qsys/.qsys_edit/
example/de10_lite_nios/software/bsp/
example/de10_lite_nios/software/obj/
example/de10_lite_nios/software/Makefile
example/de10_lite_nios/software/*.elf
example/de10_lite_nios/software/*.map
example/de10_lite_nios/software/*.objdump
example/de10_lite_nios/qsys/firewall_sys.sopcinfo
