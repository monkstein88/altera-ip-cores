# =============================================================================
# Reference specifications - NOT REDISTRIBUTED
#
# The RTL is written against the SD Association's Physical Layer Simplified
# Specification (v4.10) and Host Controller Simplified Specification (v4.20).
# Neither is kept in this repository: the SDA's Simplified Specifications are
# free to download from sdcard.org, but that is not the same as free to
# redistribute, and this repository is public. The same reasoning already
# applies to Intel's generated SDRAM controller output in
# altera_avalon_new_sdram_controller/ - see that directory's NOTICE.
#
# Anyone building this core downloads the specifications themselves. The design
# document cites section numbers throughout so that is straightforward.
#
# This rule is a backstop in case a copy is ever dropped in here again.
# =============================================================================
doc/specs/

# Simulation build artifacts. Everything here is regenerated by
# simulation/questa/run_sim.tcl or simulation/verilator/run_sim.sh.

# Questa / ModelSim
work/
transcript
run.log
*.ucdb
*.wlf
*.vstf
modelsim.ini
vsim.dbg
coverage_report.txt
covhtmlreport/

# Verilator
obj_dir/
obj_dir_*/
run_*.log
coverage.dat

# Icarus
*.out
*.vvp
*.vcd

# Python (diagram generator, slang checker, fact checker)
__pycache__/
*.pyc

# Document build intermediates. The .md and the .pdf are tracked; the HTML
# handed to WeasyPrint is a debugging aid only.
doc/tools/.render_*.html

# Editor / OS
*~
.DS_Store

# Waveform capture (regenerated by verification/capture.sh)
verification/wave.vcd
verification/obj_dir/

# Quartus build artifacts. Everything here is regenerated by a compile; the
# .qpf/.qsf/.sdc are the tracked sources. The .sof is deliberately NOT tracked -
# a bitstream that drifts from the RTL beside it is worse than no bitstream.
db/
incremental_db/
output_files/
*.qws
*.sof
*.pof
*.rpt
*.summary
*.jdi
*.pin
*.done
*.smsg
*.sld
*.qdf
hc_output/
greybox_tmp/

# Platform Designer generated output. Regenerated from qsys/build_system.tcl
# and the .qsys file, both of which ARE tracked.
**/qsys/*_sys/
**/qsys/.qsys_edit/
*.sopcinfo

# Nios II example build artifacts
example/de10_lite_nios/software/bsp/
example/de10_lite_nios/software/obj/
example/de10_lite_nios/software/Makefile
example/de10_lite_nios/software/*.elf
example/de10_lite_nios/software/*.map
example/de10_lite_nios/software/*.objdump

# Hardware-run capture written by run_on_board.sh
run_on_board.log
