<?xml version="1.0" encoding="UTF-8"?>
<!--
  Platform Designer presets for altera_avalon_mm_sdram_controller.

  A preset is a named set of parameter values. Selecting one in the component's
  "Presets" list fills in the geometry, timing and refresh figures for a
  particular part, so the numbers come from a datasheet once rather than from
  each integrator's memory every time.

  TWO RULES THIS FILE HAS TO OBEY, BOTH LEARNED THE HARD WAY

  1. A preset name may not contain parentheses or commas. Quartus 18.1 loads
     such a preset without complaint and then cannot find it by name:
     apply_preset reports "No preset named ... was found". Spaces and hyphens
     are fine, and Intel's own preset names use them.

  2. An XML comment may not contain a double hyphen, so no dashed underlines
     in here. A malformed comment makes the whole file fail to load, and the
     only symptom is a Presets list that is silently empty.

  ADDING A PART

  Copy the preset block, change the name and the values, and reload the
  component. Take every figure from the manufacturer's datasheet for the exact
  speed grade you are fitting: a timing constant that is one grade optimistic
  produces a design that passes every simulation, works on the bench, and
  corrupts data once the board is warm. There is deliberately no "generic
  SDRAM" preset for that reason, and only parts whose timing has been checked
  against a datasheet AND exercised through benchmark/ appear here.

  tMRD, tRRD and tWR are quoted by many datasheets in CLOCKS rather than in
  nanoseconds - on this part all three are 2 cycles at every speed grade, and
  the nanosecond column is just 2 x that grade's tCK written out. Use the
  nanosecond figure for the grade you are fitting when the datasheet gives one
  (this part does: 14 ns at -7); otherwise multiply the clock count by the tCK
  of the slowest grade the part is rated for.

  Either way the HDL floors those three at 2 cycles, because a nanosecond
  figure derived from a fast grade's tCK converts back to fewer than 2 cycles
  once the controller is clocked slowly enough - below about 71 MHz for a 14 ns
  figure. Do not rely on the floor to rescue a wrong number; it exists so that
  a right number stays right at every clock.
-->
<ip>
  <presets version="12.1">

    <preset
       name="ISSI IS42S16320D-7 - DE10-Lite 64 MByte"
       kind="altera_avalon_mm_sdram_controller"
       version="all"
       description="ISSI IS42S16320D-7TL. 32M x 16, 4 banks x 8192 rows x 1024 columns, CAS 3. The part fitted to the Terasic DE10-Lite. These are the figures the controller's published benchmark results were measured with.">
      <parameter name="DATA_BITS"     value="16" />
      <parameter name="ROW_BITS"      value="13" />
      <parameter name="COL_BITS"      value="10" />
      <parameter name="BANK_BITS"     value="2" />
      <parameter name="SA_BITS"       value="13" />

      <parameter name="T_RC_NS"       value="60.0" />
      <parameter name="T_RAS_NS"      value="37.0" />
      <parameter name="T_RP_NS"       value="15.0" />
      <parameter name="T_RCD_NS"      value="15.0" />
      <parameter name="T_RRD_NS"      value="14.0" />
      <parameter name="T_WR_NS"       value="14.0" />
      <parameter name="T_MRD_NS"      value="14.0" />
      <parameter name="T_RFC_NS"      value="60.0" />
      <parameter name="CAS_LAT"       value="3" />

      <parameter name="T_INIT_US"     value="100" />
      <parameter name="INIT_REFS"     value="8" />

      <parameter name="REF_ROWS"      value="8192" />
      <parameter name="REF_PERIOD_MS" value="64" />
      <parameter name="REF_MAX_PEND"  value="8" />

      <parameter name="ADDR_MAP"      value="0" />
      <parameter name="FIFO_DEPTH"    value="8" />
      <parameter name="LOOKAHEAD"     value="1" />
      <parameter name="RD_EXTRA_LAT"  value="0" />
    </preset>

  </presets>
</ip>
