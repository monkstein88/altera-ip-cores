# =============================================================================
# de10_lite_sdram_demo.qsf
#
# Quartus settings for the Avalon-MM SDRAM Controller demo on the Terasic
# DE10-Lite (Intel MAX 10, 10M50DAF484C7G, 484-pin FBGA, speed grade 7).
#
# PIN ASSIGNMENTS are taken verbatim from DE10_LITE_Golden_Top.qsf on the
# DE10-Lite System CD v2.2.0. If your board is a different revision, diff
# against that revision's Golden Top before the first run - a wrong pin on a
# 3.3 V bank is the one mistake in this file that can damage hardware.
#
# All demo I/O is on 3.3 V banks. STRATIX_DEVICE_IO_STANDARD is the assignment
# that sets the device-wide default in Quartus 18.1 (DEFAULT_IO_STANDARD is
# not a recognised name and makes the .qsf unreadable).
# =============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_sdram_demo
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# MAX 10 configuration. SINGLE IMAGE WITH ERAM is the DE10-Lite default and is
# what lets the design come up from internal flash at power-on rather than
# needing a JTAG download every time.
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name ENABLE_BOOT_SEL_PIN OFF
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CRC_ERROR_OPEN_DRAIN OFF

# Unused pins tri-stated with a weak pull-up: the DE10-Lite has VGA, an
# accelerometer and Arduino headers wired to pins this design never drives,
# and leaving them driven would fight the on-board devices.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ---------------------------------------------------------------------------
# Source files.
#
# The controller itself is not listed here: it comes in through the Platform
# Designer system's generated .qip, which is the last entry. That file is
# produced by ../build.sh qsys from qsys/build_system.tcl, so this project
# always compiles whatever is actually in the component directory.
# ---------------------------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/sdram_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../common/demo_avl_mm_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../common/demo_sdram_seq.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../common/hex7seg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../common/key_debounce.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de10_lite_sdram_demo.sv
set_global_assignment -name QIP_FILE ../qsys/sdram_perbank_sys/synthesis/sdram_perbank_sys.qip
set_global_assignment -name SDC_FILE de10_lite_sdram_demo.sdc

# ---------------------------------------------------------------------------
# In-System Sources and Probes.
#
# Exposes the sequencer's controls, its pass bitmap and its cycle counters
# over JTAG, so the demo can be regression-tested on real hardware from a
# script instead of by reading the seven-segment displays, and so the
# throughput figures can be printed with units. See run_on_board.sh.
#
# The RTL is guarded by this macro, so simulation never has to resolve the
# altsource_probe megafunction.
# ---------------------------------------------------------------------------
set_global_assignment -name VERILOG_MACRO "ENABLE_ISSP=1"

# ---- clock, buttons, switches, LEDs, displays ----------------------
# Identical to the firewall demos in this repository, which were diffed
# against the same Golden Top.
set_location_assignment PIN_P11 -to "MAX10_CLK1_50"
set_location_assignment PIN_B8 -to "KEY[0]"
