# =============================================================================
# de0_nano_sdram_nios.qsf
#
# Quartus settings for the Nios II SDRAM controller example on the DE0-Nano.
#
# Pin assignments are the DE0-Nano RTL example's, checked line by line against
# the pin table in the DE0-Nano User Manual.
#
# QUARTUS 18.1 IS REQUIRED. Newer Quartus Standard releases no longer ship the
# Nios II processor IP: in 25.1std ip/altera/nios2_ip is empty, so Platform
# Designer cannot instantiate altera_nios2_gen2 and this system will not build
# there. The SDRAM controller itself is unaffected - only the CPU is missing.
# =============================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY de0_nano_nios_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ---------------------------------------------------------------------------
# Source files. The CPU, the on-chip RAM and the SDRAM controller all arrive
# through the Platform Designer system's .qip, produced by ../build.sh qsys.
# ---------------------------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/sdram_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/de0_nano_nios_top.sv
set_global_assignment -name QIP_FILE ../qsys/sdram_nios_nano_sys/synthesis/sdram_nios_nano_sys.qip
set_global_assignment -name SDC_FILE de0_nano_sdram_nios.sdc

# ---- clock, buttons, switches, LEDs, SDRAM -------------------------------
set_location_assignment PIN_R8 -to "CLOCK_50"
set_location_assignment PIN_J15 -to "KEY[0]"
set_location_assignment PIN_E1 -to "KEY[1]"
set_location_assignment PIN_M1 -to "SW[0]"
set_location_assignment PIN_T8 -to "SW[1]"
