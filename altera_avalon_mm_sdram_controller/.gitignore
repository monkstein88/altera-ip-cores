# committed component by example/de10_lite_rtl/build.sh
example/de10_lite_rtl/qsys/sdram_perbank_sys/
example/de10_lite_rtl/qsys/sdram_perbank_sys.sopcinfo
example/de10_lite_rtl/qsys/.qsys_edit/
example/de10_lite_rtl/simulation/verilator/.build/
example/de10_lite_rtl/simulation/verilator/.*.log

# Intermediate HTML from build_pdf.py
doc/tools/.render_*.html

# Questa assertion report
simulation/questa/assert_report.txt

